[Unit]
Description=Sample Minecraft/Crafty host state
After=crafty.service time-sync.target
Wants=time-sync.target

[Service]
Type=oneshot
User=crafty
Group=crafty
ExecStart=/usr/local/bin/mcctl monitor sample --config /etc/mcctl/config.json
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mcctl /run/mcctl
MemoryMax=50M
CPUQuota=5%
